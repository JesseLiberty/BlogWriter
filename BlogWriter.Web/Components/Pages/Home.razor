@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@inject BlogWorkspaceService Workspace

<PageTitle>Blog Writer</PageTitle>

<div class="workspace @(Workspace.State.Mode == WorkspaceMode.Ended ? "workspace-ended" : "")">
    <header class="workspace-intro">
        <div>
            <p class="eyebrow">Editorial workspace</p>
            <h1>Write. Review. Refine.</h1>
        </div>
        <p class="workspace-summary">A researcher and author for blog pages.</p>
    </header>

    @if (Workspace.State.Mode == WorkspaceMode.Ended)
    {
        <section class="ended-state" aria-labelledby="ended-heading">
            <p class="eyebrow">Session closed</p>            
            <p>Refresh the page when you are ready to begin another session.</p>
        </section>
    }
    else
    {
        <section class="prompt-strip" aria-label="Writing prompts">
            <PromptInput @ref="_initialPrompt"
                         Id="initial-prompt"
                         Label="New query"
                         Value="@Workspace.State.InitialPrompt"
                         ValueChanged="value => Workspace.State.InitialPrompt = value"
                         Disabled="@(!Workspace.State.IsInitialPromptEnabled)" />
            <PromptInput Id="revision-prompt"
                         Label="Revision request"
                         Value="@Workspace.State.RevisionPrompt"
                         ValueChanged="value => Workspace.State.RevisionPrompt = value"
                         Disabled="@(!Workspace.State.IsRevisionInputEnabled)" />
        </section>

        <WordRangeInput Disabled="@(!Workspace.State.IsWordRangeEnabled)"
            MinValue="@Workspace.State.MinWordsInput"
                MinValueChanged="Workspace.UpdateMinWords"
                MaxValue="@Workspace.State.MaxWordsInput"
                MaxValueChanged="Workspace.UpdateMaxWords"
                MinError="@Workspace.State.MinWordsError"
                MaxError="@Workspace.State.MaxWordsError"/>
 
        <section class="work-grid">
            @if (Workspace.State.Mode == WorkspaceMode.List)
            {
                <DraftPane>
                    @if (Workspace.State.DisplayedSessions.Count == 0)
                    {
                        <p class="empty-copy">No saved sessions are available.</p>
                    }
                    else
                    {
                        <SessionList Sessions="@Workspace.State.DisplayedSessions" />
                    }
                </DraftPane>
            }
            else
            {
                <DraftPane Content="@Workspace.State.Draft" />
            }
            <ReviewPane Content="@Workspace.State.Review" />
        </section>

        <footer class="workspace-footer">
            <CommandBar New="() => RequestTransitionAsync(PendingAction.New)"
                        List="() => RequestTransitionAsync(PendingAction.List)"
                        SelectionChanged="Workspace.LaunchSelectionAsync"
                        SelectionVisible="@Workspace.State.IsSelectionVisible"
                        SelectionEnabled="@Workspace.State.IsSelectionInputEnabled"
                        SelectionInput="@Workspace.State.SelectionInput"
                        SelectionError="@Workspace.State.SelectionError"
                        NewEnabled="@Workspace.State.IsNewCommandEnabled"
                        ListEnabled="@Workspace.State.IsListCommandEnabled"
                        GoEnabled="@Workspace.State.IsGoCommandEnabled"
                        QuitEnabled="@Workspace.State.IsQuitCommandEnabled"
                        HelpEnabled="@Workspace.State.IsHelpCommandEnabled"
                        Go="Workspace.SubmitAsync"
                        Quit="() => RequestTransitionAsync(PendingAction.Quit)"
                        Help="ShowHelp" />

            <WorkflowLog CurrentStatus="@Workspace.State.CurrentStatus"
                         CurrentStatusOutcome="@Workspace.State.CurrentStatusOutcome" />

        </footer>

    }
</div>

@if (_showDiscardDialog)
{
    <ConfirmDiscardDialog Accept="ConfirmTransitionAsync" Decline="DeclineTransition" />
}

@if (_showHelpDialog)
{
    <RunCommandDialog Closed="CloseHelp" />
}

@code {
    private PromptInput? _initialPrompt;
    private PendingAction _pendingAction;
    private bool _showDiscardDialog;
    private bool _showHelpDialog;

    protected override void OnInitialized() => Workspace.Changed += HandleWorkspaceChanged;

    public void Dispose() => Workspace.Changed -= HandleWorkspaceChanged;

    private async Task RequestTransitionAsync(PendingAction action)
    {
        _pendingAction = action;
        WorkspaceTransitionResult result = await ExecuteTransitionAsync(action, discardConfirmed: false);
        if (result == WorkspaceTransitionResult.RequiresConfirmation)
        {
            _showDiscardDialog = true;
        }
        else if (action == PendingAction.New && _initialPrompt is not null)
        {
            await _initialPrompt.FocusAsync();
        }
    }

    private async Task ConfirmTransitionAsync()
    {
        _showDiscardDialog = false;
        PendingAction action = _pendingAction;
        _pendingAction = PendingAction.None;
        await ExecuteTransitionAsync(action, discardConfirmed: true);
        if (action == PendingAction.New && _initialPrompt is not null)
        {
            await _initialPrompt.FocusAsync();
        }
    }

    private void DeclineTransition()
    {
        _showDiscardDialog = false;
        _pendingAction = PendingAction.None;
    }

    private void ShowHelp() => _showHelpDialog = true;

    private void CloseHelp() => _showHelpDialog = false;

    private Task<WorkspaceTransitionResult> ExecuteTransitionAsync(PendingAction action, bool discardConfirmed) =>
        action switch
        {
            PendingAction.New => Workspace.NewAsync(discardConfirmed),
            PendingAction.List => Workspace.ListAsync(discardConfirmed),
            PendingAction.Quit => Workspace.QuitAsync(discardConfirmed),
            _ => Task.FromResult(WorkspaceTransitionResult.Completed),
        };

    private void HandleWorkspaceChanged() => _ = InvokeAsync(StateHasChanged);

    private enum PendingAction
    {
        None,
        New,
        List,
        Quit,
    }
}
