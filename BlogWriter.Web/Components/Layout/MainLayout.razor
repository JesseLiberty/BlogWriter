@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <a class="brand" href="/">Blog Writer</a>
        <AuthorizeView>
            <Authorized>
                <span class="user-name">
                    <span class="display-name">Jesse Liberty</span>
                    <span class="user-role">Senior AI Engineer</span>
                </span>
                <a class="sign-out" href="MicrosoftIdentity/Account/SignOut">Sign out</a>
            </Authorized>
        </AuthorizeView>
    </header>

    <main class="app-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
