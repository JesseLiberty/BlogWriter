<nav class="command-bar" aria-label="Workspace commands">
    <button type="button" data-command="new" disabled="@(!NewEnabled)" @onclick="New">New</button>
    <div class="list-command">
        <button type="button" data-command="list" disabled="@(!ListEnabled)" @onclick="List">List</button>
        @if (SelectionVisible)
        {
            <label class="sr-only" for="command-session-number">Saved session number</label>
            <input id="command-session-number"
                   data-command="session-number"
                   inputmode="numeric"
                   maxlength="3"
                   pattern="[0-9]*"
                   value="@SelectionInput"
                   disabled="@(!SelectionEnabled)"
                   aria-invalid="@(!string.IsNullOrWhiteSpace(SelectionError))"
                   aria-describedby="command-session-error"
                   @onchange="HandleSelectionChanged" />
            @if (!string.IsNullOrWhiteSpace(SelectionError))
            {
                <span id="command-session-error" class="sr-only">@SelectionError</span>
            }
        }
    </div>
    <button type="button" class="range-go" data-command="go" disabled="@(!GoEnabled)" @onclick="Go">Go</button>
    <button type="button" data-command="quit" disabled="@(!QuitEnabled)" @onclick="Quit">Quit</button>
    <button type="button" class="help-command" data-command="help" disabled="@(!HelpEnabled)" aria-label="Help" @onclick="Help">?</button>
</nav>

@code {
    [Parameter]
    public EventCallback New { get; set; }

    [Parameter]
    public EventCallback List { get; set; }

    [Parameter]
    public EventCallback<string> SelectionChanged { get; set; }

    [Parameter]
    public bool SelectionVisible { get; set; }

    [Parameter]
    public bool SelectionEnabled { get; set; } = true;

    [Parameter]
    public string SelectionInput { get; set; } = "";

    [Parameter]
    public string? SelectionError { get; set; }

    [Parameter]
    public bool NewEnabled { get; set; } = true;

    [Parameter]
    public bool ListEnabled { get; set; } = true;

    [Parameter]
    public bool GoEnabled { get; set; } = true;

    [Parameter]
    public bool QuitEnabled { get; set; } = true;

    [Parameter]
    public bool HelpEnabled { get; set; } = true;

    [Parameter]
    public EventCallback Quit { get; set; }

    [Parameter]
    public EventCallback Help { get; set; }

    [Parameter]
    public EventCallback Go { get; set; }

    private Task HandleSelectionChanged(ChangeEventArgs args) =>
        SelectionChanged.InvokeAsync(args.Value?.ToString() ?? "");
}
