<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>BlogWriter.HostedAgents.Researcher</AssemblyName>
    <RootNamespace>BlogWriter.HostedAgents.Researcher</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>a3f0f2b0-9c7f-4c34-9e26-3c26d2a6f2b1</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reused only for the shared Prompts.ResearcherInstructions constant (single
         source of truth with the console app) — no other main-app types are referenced. -->
    <ProjectReference Include="..\..\BlogWriter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" Version="1.20.0-preview.260831.1" />
    <PackageReference Include="Azure.AI.Projects" Version="2.1.0-beta.4" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

</Project>
